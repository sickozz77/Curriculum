{
    "name": "laravel/laravel",
    "type": "project",
    "description": "Aplicativo Php Framework Laravel.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Edmilson Jhoaquim",
            "email": "edjo90@yahoo.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "endroid/qr-code": "^6.0",
        "laravel/framework": "^11.0",
        "laravel/jetstream": "^5.1",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "livewire/livewire": "^3.0",
        "phpoffice/phpword": "^1.3",
        "positus/positus-api-laravel-client": "^0.1.0",
        "spatie/laravel-permission": "^6.20"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "fakerphp/faker": "^1.23",
        "laravel-lang/common": "^6.7",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "laravel/tinker": "^2.9",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Positus\\Laravel\\": "src"
        },
        "files": [
            "app/Helpers/DateFormat.php",
            "app/Helpers/funcoes.php",
            "app/Helpers/DadosPessoais.php",
            "app/Helpers/extenso.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "providers": [
                "Positus\\Laravel\\ClientServiceProvider"
            ],
            "aliases": {
                "Positus": "Positus\\Laravel\\ClientFacade"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
